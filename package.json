{
  "name": "minevlayer",
  "version": "0.3.0",
  "description": "Smart TypeScript layer over Mineflayer: 1 action = 1 line. Mineflayer stays untouched, vendored in vendor/mineflayer.",
  "keywords": ["minecraft", "mineflayer", "bot", "minecraft-bot", "wrapper", "typescript", "one-liner"],
  "author": "vlalikoffc <225565472+vlalikoffc@users.noreply.github.com>",
  "contributors": ["PrismarineJS (Mineflayer engine, vendored in vendor/mineflayer)"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && mocha 'test/unit/**/*.test.js' --exit",
    "test:vendor": "cd vendor/mineflayer && npm install && npm run mocha_test",
    "pretest": "npm run lint",
    "lint": "standard --ignore-pattern dist --ignore-pattern vendor --ignore-pattern node_modules && standard-markdown README.md",
    "fix": "standard --fix --ignore-pattern dist --ignore-pattern vendor && standard-markdown --fix README.md",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "vendor/mineflayer/",
    "index.js",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/vlalikoffc/minevlayer.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "mineflayer": "file:vendor/mineflayer",
    "minecraft-data": "^3.114.0",
    "minecraft-protocol": "^1.67.0",
    "mojangson": "^2.0.4",
    "prismarine-biome": "^1.1.1",
    "prismarine-block": "^1.22.0",
    "prismarine-chat": "^1.7.1",
    "prismarine-chunk": "^1.41.0",
    "prismarine-entity": "^2.5.0",
    "prismarine-item": "^1.17.0",
    "prismarine-nbt": "^2.0.0",
    "prismarine-physics": "^1.11.1",
    "prismarine-recipe": "^1.5.0",
    "prismarine-registry": "^1.10.0",
    "prismarine-windows": "^2.9.0",
    "prismarine-world": "^3.6.0",
    "protodef": "^1.18.0",
    "typed-emitter": "^1.0.0",
    "uuid-1345": "^1.0.2",
    "vec3": "^0.1.7"
  },
  "peerDependencies": {
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-collectblock": "^1.2.0",
    "mineflayer-pvp": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "mineflayer-pathfinder": { "optional": true },
    "mineflayer-collectblock": { "optional": true },
    "mineflayer-pvp": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "mocha": "^11.0.1",
    "standard": "^17.0.0",
    "standard-markdown": "^7.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "license": "MIT"
}
